<?xml version="1.0" encoding="utf-8"?>
<!-- 가방 목록이 열렸을 때 가방 버튼: 목록과 같은 가죽 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/panel_leather" />
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#A07E48"
                android:dashGap="4dp"
                android:dashWidth="5dp" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
