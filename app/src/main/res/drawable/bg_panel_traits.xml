<?xml version="1.0" encoding="utf-8"?>
<!-- 특성 바꾸기 창의 특성 버튼 판: 전투 창 가방처럼 가죽과 바느질 테두리 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/panel_leather" />
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#A07E48"
                android:dashGap="4dp"
                android:dashWidth="5dp" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
