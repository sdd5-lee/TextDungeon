<?xml version="1.0" encoding="utf-8"?>
<!-- 특성 바꾸기 창의 특성 버튼 (전투 가방 버튼 모양). 눌러서 설명을 보는 중인 버튼은 금색 테두리 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A3B32" />
            <stroke android:width="2dp" android:color="#E9C176" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A3B32" />
            <stroke android:width="1dp" android:color="#E9C176" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A2A2A" />
            <stroke android:width="1dp" android:color="#8B7355" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
