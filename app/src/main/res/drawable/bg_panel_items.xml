<?xml version="1.0" encoding="utf-8"?>
<!-- 전투 창 가방 목록 바탕: 가죽, 바느질 테두리, 가운데 흐린 가방 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/panel_leather" />
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#A07E48"
                android:dashGap="4dp"
                android:dashWidth="5dp" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_bag"
            android:tint="#38E9C176"
            android:tintMode="src_in" />
    </item>
</layer-list>
