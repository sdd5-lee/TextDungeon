<?xml version="1.0" encoding="utf-8"?>
<!-- 전투 창 마법 버튼 바탕. 목록이 열려 있으면(selected) 목록과 같은 양피지 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C2740" />
            <stroke android:width="1dp" android:color="#4A78C8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true" android:drawable="@drawable/panel_parchment" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141A27" />
            <stroke android:width="1dp" android:color="#26406E" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
