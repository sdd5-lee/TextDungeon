<?xml version="1.0" encoding="utf-8"?>
<!-- 스탯 창 (게임 화면에서 얼굴·HP·스탯을 누르면 뜬다). 캐릭터 선택 화면처럼
     위에 직업 초상화와 이름·특성 배지, 아래에 HP·경험치와 능력치 막대, 전투·골드 칸, 특성 카드, 가방 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_rounded_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <ImageView
                    android:id="@+id/info_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_portrait_fade" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/info_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.15"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:textColor="#C9A86A"
                        android:textSize="13sp"
                        tools:text="LV. 3 · 전사" />

                    <TextView
                        android:id="@+id/info_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.05"
                        android:shadowColor="#000000"
                        android:shadowRadius="8"
                        android:textColor="#E9C176"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="강철의 브란" />

                    <TextView
                        android:id="@+id/info_trait_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_trait_badge"
                        android:fontFamily="serif"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="#E9C176"
                        android:textSize="13sp"
                        tools:text="특성 · 불굴" />
                </LinearLayout>
            </FrameLayout>

            <!-- HP·경험치 막대 (코드에서 채운다) -->
            <LinearLayout
                android:id="@+id/info_gauges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp" />

            <TextView
                style="@style/InfoSectionLabel"
                android:text="능력치" />

            <!-- 힘·민첩·체력·지혜 막대 (코드에서 채운다) -->
            <LinearLayout
                android:id="@+id/info_stat_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp" />

            <!-- 공격력·크리티컬·골드·남은 스탯 포인트 네 칸 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout style="@style/InfoTile">

                    <TextView
                        style="@style/InfoTileLabel"
                        android:text="공격력" />

                    <TextView
                        android:id="@+id/info_atk"
                        style="@style/InfoTileValue"
                        tools:text="24" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InfoTile"
                    android:layout_marginStart="8dp">

                    <TextView
                        style="@style/InfoTileLabel"
                        android:text="크리티컬" />

                    <TextView
                        android:id="@+id/info_crit"
                        style="@style/InfoTileValue"
                        tools:text="10%" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout style="@style/InfoTile">

                    <TextView
                        style="@style/InfoTileLabel"
                        android:text="골드" />

                    <TextView
                        android:id="@+id/info_gold"
                        style="@style/InfoTileValue"
                        tools:text="120" />
                </LinearLayout>

                <LinearLayout
                    style="@style/InfoTile"
                    android:layout_marginStart="8dp">

                    <TextView
                        style="@style/InfoTileLabel"
                        android:text="남은 스탯 포인트" />

                    <TextView
                        android:id="@+id/info_stat_point"
                        style="@style/InfoTileValue"
                        tools:text="0" />
                </LinearLayout>
            </LinearLayout>

            <!-- 특성 카드 (캐릭터 선택의 특성 카드와 같은 모양) -->
            <LinearLayout
                android:id="@+id/info_trait_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/InfoSectionLabel"
                    android:text="특성" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_trait_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/info_trait_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="#E9C176"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="불굴" />

                    <TextView
                        android:id="@+id/info_trait_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#A39C92"
                        android:textSize="14sp"
                        tools:text="HP가 30% 이하일 때 공격력이 50% 증가합니다." />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/InfoSectionLabel"
                android:text="가방" />

            <!-- 가진 물건 줄 (코드에서 채운다) -->
            <LinearLayout
                android:id="@+id/info_equip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_trait_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btn_info_close"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_trait_close"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="serif"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:text="닫기"
        android:textColor="#BDB6AD"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
