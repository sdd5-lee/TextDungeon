<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 선택에서 시작을 누르면 뜨는 이름 정하기 창 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/name_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_parchment"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="당신의 이름은?"
        android:textColor="#5A2C14"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_name_job"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="#6B4A2E"
        android:textSize="13sp"
        tools:text="전사 · 불굴" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edit_player_name"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_name_input"
            android:fontFamily="serif"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:selectAllOnFocus="true"
            android:textColor="#2B1A10"
            android:textColorHint="#9C7E5C"
            android:textSize="20sp"
            tools:text="강철의 브란" />

        <ImageView
            android:id="@+id/btn_name_dice"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_name_dice"
            android:clickable="true"
            android:contentDescription="이름 뽑기"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_dice" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_recent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:text="지난번 이름"
        android:textColor="#6B4A2E"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/recent_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/recent_names"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="10글자까지 · 비워 두면 주사위 이름으로 시작"
        android:textColor="#8A6A46"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_name_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_name_back"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="돌아가기"
            android:textColor="#6B4A2E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_name_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_name_ok"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:text="출발"
            android:textColor="#F0E2C4"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
