<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background"
    android:backgroundTint="#1E1E1E"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INVENTORY"
        android:textColor="#E9C176"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="✕"
        android:textColor="#E9C176"
        android:textSize="20sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Equipment Slots (4 fixed slots) -->

    <LinearLayout
        android:id="@+id/equipment_slots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_title">

        <!-- Weapon -->
        <FrameLayout
            android:id="@+id/slot_weapon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_event_panel">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:padding="12dp"
                android:src="@drawable/ic_weapon"
                android:tint="#ffffff"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Armor -->
        <FrameLayout
            android:id="@+id/slot_armor"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_event_panel">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:padding="12dp"
                android:src="@drawable/ic_armor"
                android:tint="#ffffff"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- artifact 1 -->
        <FrameLayout
            android:id="@+id/slot_atf_1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_event_panel">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:padding="12dp"
                android:src="@drawable/ic_artifact"
                android:tint="#ffffff"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- artifact 2 -->
        <FrameLayout
            android:id="@+id/slot_atf_2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_event_panel">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:padding="12dp"
                android:src="@drawable/ic_artifact"
                android:tint="#ffffff"
                tools:ignore="ContentDescription" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#33E9C176"
        app:layout_constraintTop_toBottomOf="@id/equipment_slots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bag Slots (5x6 Grid, Scrollable) -->
    <ScrollView
        android:id="@+id/bag_scroll"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <GridLayout
            android:id="@+id/bag_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:columnCount="5"
            android:padding="4dp">

            <!-- 30 Slots (5x6) -->
            <!-- Row 1 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <!-- Row 2 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <!-- Row 3 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <!-- Row 4 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <!-- Row 5 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <!-- Row 6 -->
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="2dp" android:background="@drawable/bg_event_panel" />

        </GridLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>