<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/battle_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_background"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Status Header: Player & Monster -->
    <LinearLayout
        android:id="@+id/status_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 플레이어 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1C1B1B"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginEnd="2dp">

            <TextView
                android:id="@+id/player_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="PLAYER"
                android:textColor="#E5E2E1"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:fontFamily="serif"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="#0E0E0E"
                android:orientation="horizontal"
                android:weightSum="1">
                <View
                    android:id="@+id/player_hp_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#901418" />
            </LinearLayout>

            <TextView
                android:id="@+id/player_hp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E0BFBA"
                android:textSize="11sp"
                tools:text="HP: 84 / 120" />
        </LinearLayout>

        <!-- 몹 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1C1B1B"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="end"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/monster_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="고블린"
                android:textColor="#E9C176"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:fontFamily="serif"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="#0E0E0E"
                android:orientation="horizontal"
                android:gravity="end"
                android:weightSum="1">
                <View
                    android:id="@+id/monster_hp_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#901418" />
            </LinearLayout>

            <TextView
                android:id="@+id/monster_hp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E0BFBA"
                android:textSize="11sp"
                tools:text="150 / 150" />
        </LinearLayout>
    </LinearLayout>

    <!-- 몹 이미지 -->
    <FrameLayout
        android:id="@+id/monster_image_area"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="4dp"
        android:background="#0E0E0E">

        <ImageView
            android:id="@+id/battle_monster_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.7"
            tools:src="@android:drawable/ic_menu_report_image"/>

    </FrameLayout>

    <!-- 배틀 로그 -->
    <LinearLayout
        android:id="@+id/log_area"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        android:background="#1C1B1B"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <!-- 로그 출력 부분 -->
            <TextView
                android:id="@+id/battle_log_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="2dp"
                android:textColor="#E0BFBA"
                android:textSize="12sp"
                tools:text="The Bone-Stalker shrieks in the darkness.\nYou hit for 12 damage with Quick Strike." />
        </ScrollView>
        <!-- 전체 로그 버튼   -->
    </LinearLayout>

    <!-- Combat Actions -->
    <!-- 버튼은 아이콘 위, 작은 글자 아래. 버튼 사이·줄 사이는 8dp -->
    <LinearLayout
        android:id="@+id/actions_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:animateLayoutChanges="true">

        <!-- 공격, 방어, 도망 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/battle_btn_attack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_battle_attack"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_weapon"
                    app:tint="#F07A70" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="공격"
                    android:textColor="#F07A70"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/battle_btn_guard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_battle_guard"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    app:tint="#8FB4E3" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="방어"
                    android:textColor="#8FB4E3"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/battle_btn_escape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_battle_escape"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_run"
                    app:tint="#A8A79C" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="도망"
                    android:textColor="#A8A79C"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 마법(스킬) 목록: 양피지. 열리면 마법 버튼도 같은 양피지가 된다 -->
        <ScrollView
            android:id="@+id/magic_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_parchment"
            android:fillViewport="true"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/magic_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="12dp">

            </GridLayout>
        </ScrollView>

        <!-- 가방(아이템) 목록: 가죽과 가방. 열리면 가방 버튼도 같은 가죽이 된다 -->
        <ScrollView
            android:id="@+id/items_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel_items"
            android:fillViewport="true"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="12dp">

            </GridLayout>
        </ScrollView>

        <!-- 하단바 마법, 가방 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/battle_btn_magic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_battle_magic"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_magic"
                    app:tint="@color/battle_magic_fg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:duplicateParentState="true"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="마법"
                    android:textColor="@color/battle_magic_fg"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/battle_btn_items"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_battle_items"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bag"
                    app:tint="#E9C176" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.1"
                    android:text="가방"
                    android:textColor="#E9C176"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
