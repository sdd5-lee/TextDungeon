<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_event_panel"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- 업그레이드명 -->
        <TextView
            android:id="@+id/upgrade_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.05"
            android:textColor="#E9C176"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="초기 여유 스탯 추가" />
        <!-- 레벨 표시 -->
        <TextView
            android:id="@+id/upgrade_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="#E5E2E1"
            android:textSize="13sp"
            tools:text="LV. 2 / 5" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#33E9C176" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <!-- 설명 -->
            <TextView
                android:id="@+id/upgrade_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                tools:text="시작 시 부여되는 보너스 스탯이 증가합니다." />
            <!-- 수치 표시 -->
            <TextView
                android:id="@+id/upgrade_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:textColor="#E9C176"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="10 > 12" />
        </LinearLayout>
        <!-- 구매 버튼 -->
        <LinearLayout
            android:id="@+id/btn_upgrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shop_btn"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="90dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">
            <TextView
                android:id="@+id/upgrade_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="#E9C176"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1,500G" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.1"
                android:text="BUY"
                android:textColor="#E9C176"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>