<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B"
    android:padding="16dp">

    <TextView
        android:id="@+id/admin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="[ 관리자 전용 패널 ]"
        android:textColor="#E9C176"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/admin_title"
        app:layout_constraintBottom_toTopOf="@id/btn_close_admin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_admin_add_gold"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:text="돈(Gem) +10,000 추가"
            android:textColor="#111111"
            android:backgroundTint="#E9C176"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_admin_unlock_all"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:text="도감 전체 해금"
            android:textColor="#E5E2E1"
            android:backgroundTint="#4CAF50"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_admin_lock_all"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:text="도감 전체 잠금 (초기화)"
            android:textColor="#E5E2E1"
            android:backgroundTint="#555555"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_admin_reset_game"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:text="게임 전체 데이터 초기화"
            android:textColor="#E5E2E1"
            android:backgroundTint="#901418"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_admin_api_key"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:text="API 키 설정"
            android:textColor="#111111"
            android:backgroundTint="#7EB8E9"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_close_admin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="관리자 패널 닫기"
        android:textColor="#E5E2E1"
        android:backgroundTint="#2C2B2B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>