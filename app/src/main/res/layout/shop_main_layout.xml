<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- Header Section (통일된 규격) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#131313"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.3"
            android:text="SHOP"
            android:textColor="#E9C176"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/player_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="#E9C176"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1,200G" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33E9C176"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- 탭 메뉴 -->
    <LinearLayout
        android:id="@+id/shop_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#131313"
        app:layout_constraintTop_toBottomOf="@id/header_divider">

        <TextView
            android:id="@+id/tab_unlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:text="영웅 해금"
            android:textColor="#E9C176"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33E9C176" />

        <TextView
            android:id="@+id/tab_upgrade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:text="영구 업그레이드"
            android:textColor="#A0A0A0"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 컨텐츠 영역 -->
    <FrameLayout
        android:id="@+id/shop_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/shop_tabs"
        app:layout_constraintBottom_toTopOf="@id/bottom_action">

        <!-- 영웅 해금 (가로 스크롤) -->
        <HorizontalScrollView
            android:id="@+id/unlock_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/unlock_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- 자바 코드에서 동적으로 추가되지만, 미리보기를 위해 include 포함 -->
                <include layout="@layout/shop_character_card" />
                <include layout="@layout/shop_character_card" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 업그레이드 (세로 스크롤) -->
        <ScrollView
            android:id="@+id/upgrade_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/upgrade_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">
                <!-- 자바 코드에서 동적으로 추가되지만, 미리보기를 위해 include 포함 -->
                <include layout="@layout/shop_upgrade_card" />
                <include layout="@layout/shop_upgrade_card" />
                <include layout="@layout/shop_upgrade_card" />
                <include layout="@layout/shop_upgrade_card" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 하단바 -->
    <FrameLayout
        android:id="@+id/bottom_action"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#131313"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="serif"
            android:letterSpacing="0.2"
            android:padding="16dp"
            android:text="돌아가기"
            android:textColor="#E9C176"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="#901418" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>