<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 선택: 고른 직업 초상화를 크게, 아래 줄에서 직업을 바꾸고 특성을 고른다.
     잠긴 직업은 이름만 보이고 그림·능력치·설명·특성은 숨긴다. 시작을 누르면 이름을 묻는다 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131313">

    <ScrollView
        android:id="@+id/character_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/character_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 화면이 길면 코드에서 정사각형까지 키운다 -->
            <FrameLayout
                android:id="@+id/hero_frame"
                android:layout_width="match_parent"
                android:layout_height="340dp">

                <ImageView
                    android:id="@+id/iv_job_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- 잠긴 직업은 그림 대신 자물쇠만 -->
                <LinearLayout
                    android:id="@+id/locked_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#0E0D0C"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="#4A443D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.2"
                        android:text="잠긴 직업"
                        android:textColor="#6F6961"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_portrait_fade" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_job_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.15"
                        android:shadowColor="#000000"
                        android:shadowRadius="8"
                        android:textColor="#E9C176"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="전사" />

                    <TextView
                        android:id="@+id/tv_trait_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_trait_badge"
                        android:fontFamily="serif"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:textColor="#E9C176"
                        android:textSize="15sp"
                        tools:text="특성 · 불굴" />
                </LinearLayout>
            </FrameLayout>

            <!-- 힘·민첩·체력·지혜 막대 (코드에서 채운다) -->
            <LinearLayout
                android:id="@+id/stat_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp" />

            <TextView
                android:id="@+id/character_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:lineSpacingExtra="4dp"
                android:minLines="2"
                android:paddingHorizontal="20dp"
                android:textColor="#BDB6AD"
                android:textSize="13sp"
                tools:text="강력한 근력과 체력을 바탕으로 최전선에서 적과 맞서는 든든한 전사입니다." />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/job_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 지금 특성 카드와 옆의 바꾸기 버튼 (누르면 고를 수 있는 특성 목록 창) -->
            <LinearLayout
                android:id="@+id/trait_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="특성"
                    android:textColor="#9A948C"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_trait_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_trait_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:textColor="#E9C176"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="불굴" />

                            <TextView
                                android:id="@+id/tv_trait_tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_trait_tag"
                                android:fontFamily="serif"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textColor="#C9A86A"
                                android:textSize="11sp"
                                tools:text="기본 특성" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_trait_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="serif"
                            android:lineSpacingExtra="4dp"
                            android:minLines="2"
                            android:textColor="#A39C92"
                            android:textSize="14sp"
                            tools:text="HP가 30% 이하일 때 공격력이 50% 증가합니다." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_trait_change"
                        android:layout_width="84dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_trait_change"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_swap"
                            app:tint="#E9C176" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="serif"
                            android:gravity="center"
                            android:text="특성\n바꾸기"
                            android:textColor="#E9C176"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 아래 줄: 뒤로가기(왼쪽 1) + 시작(오른쪽 2) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1C1B1B"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:letterSpacing="0.1"
                android:text="뒤로가기"
                android:textColor="#BDB6AD"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#901418"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:letterSpacing="0.6"
                android:text="시작"
                android:textColor="#E5E2E1"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
