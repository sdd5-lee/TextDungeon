<?xml version="1.0" encoding="utf-8"?>
<!-- 던전 선택: 고른 던전 그림을 크게, 아래에 입장 조건·목표 층·배수와 설명, 맨 아래 줄에서 던전을 바꾼다.
     잠긴 던전은 그림을 어둡게 덮고 자물쇠와 여는 조건을 보여 준다 (캐릭터 선택과 같은 모양) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131313">

    <ScrollView
        android:id="@+id/dungeon_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/dungeon_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 화면이 길면 코드에서 정사각형까지 키운다 -->
            <FrameLayout
                android:id="@+id/hero_frame"
                android:layout_width="match_parent"
                android:layout_height="340dp">

                <ImageView
                    android:id="@+id/iv_dungeon_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <!-- 잠긴 던전은 그림을 어둡게 덮는다 -->
                <LinearLayout
                    android:id="@+id/locked_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC0E0D0C"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="#6F6961" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.2"
                        android:text="잠긴 던전"
                        android:textColor="#8D867C"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_portrait_fade" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dungeon_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:letterSpacing="0.15"
                        android:shadowColor="#000000"
                        android:shadowRadius="8"
                        android:textColor="#E9C176"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="어둠의 입구" />

                    <TextView
                        android:id="@+id/tv_floor_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_trait_badge"
                        android:fontFamily="serif"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:textColor="#E9C176"
                        android:textSize="15sp"
                        tools:text="목표 · 20층" />
                </LinearLayout>
            </FrameLayout>

            <!-- 입장 조건, 몬스터·보상 배수, 신들의 이벤트, 클리어 보상 (코드에서 채운다) -->
            <LinearLayout
                android:id="@+id/dungeon_conditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_trait_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp" />

            <TextView
                android:id="@+id/dungeon_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:lineSpacingExtra="4dp"
                android:minLines="3"
                android:paddingHorizontal="20dp"
                android:textColor="#BDB6AD"
                android:textSize="13sp"
                tools:text="던전의 첫 스무 층. 고블린과 짐승들이 들끓는다." />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dungeon_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- 아래 줄: 뒤로가기 + AI 없이 입장 + 입장 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1C1B1B"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:letterSpacing="0.1"
                android:text="뒤로가기"
                android:textColor="#BDB6AD"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 신들의 이벤트(온디바이스 모델) 없이 바로 들어간다 -->
        <FrameLayout
            android:id="@+id/btn_no_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#232120"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="AI 없이\n입장"
                android:textColor="#8D867C"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#901418"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:letterSpacing="0.6"
                android:text="입장"
                android:textColor="#E5E2E1"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
